# ==============================================================================
# NOVA LEARN — AI STUDY TUTOR ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your preferred AI provider.
# Keep your actual keys in .env (which is git-ignored) or hosting provider secrets.
#
# Recommended: Free tier available via Google AI Studio
# https://aistudio.google.com/app/apikey
# ==============================================================================

# Google Gemini API (Recommended: Generous free tier, fast inference)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional alternative, e.g. gpt-4o-mini)
OPENAI_API_KEY=

# Groq Cloud API (Optional alternative, high-speed Llama-3.3-70B)
GROQ_API_KEY=

# Anthropic Claude API (Optional alternative)
ANTHROPIC_API_KEY=

# OpenRouter API (Optional alternative)
OPENROUTER_API_KEY=

# Server Configuration
PORT=3001
NODE_ENV=production
