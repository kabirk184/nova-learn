# ==============================================================================
# NOVA LEARN — AI STUDY TUTOR ENVIRONMENT CONFIGURATION
# Dual-Provider Free-Tier Architecture (Groq Primary + Gemini Fallback)
# ==============================================================================
# Copy this file to .env and configure your keys.
# NEVER commit your actual .env file to GitHub.
#
# Free Provider Options (No credit card or billing required):
# 1. Groq Cloud: https://console.groq.com/keys (openai/gpt-oss-120b, 1,000 req/day free)
# 2. Google AI Studio: https://aistudio.google.com/app/apikey (gemini-3.8-flash, free tier)
#
# When both are configured, Nova Learn automatically uses Groq as primary and
# seamlessly falls back to Gemini if Groq is busy, providing ~1,300 free queries/day
# (~21 daily inquiries per student for a 60-student community).
# ==============================================================================

# Primary Provider: Groq Cloud (openai/gpt-oss-120b)
GROQ_API_KEY=

# Secondary Fallback Provider: Google Gemini (gemini-3.8-flash)
GEMINI_API_KEY=

# Optional Alternatives (pay-as-you-go / third-party)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Backend Server Configuration
PORT=3001
NODE_ENV=production
