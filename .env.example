# ==============================================================================
# NOVA LEARN — AI STUDY TUTOR ENVIRONMENT CONFIGURATION
# Dual-Provider Free-Tier Architecture (Groq Primary + Gemini Fallback)
# ==============================================================================
# Copy this file to .env and configure your keys.
# NEVER commit your actual .env file to GitHub.
#
# Free Provider Options (No credit card or billing required):
# 1. Groq Cloud: https://console.groq.com/keys (Llama-3.3-70B, 1,000 req/day free)
# 2. Google AI Studio: https://aistudio.google.com/app/apikey (Gemini 1.5 Flash, 1,500 req/day free)
#
# When both are configured, Nova Learn automatically uses Groq as primary and
# seamlessly falls back to Gemini if Groq is busy, providing 2,300+ free queries/day.
# ==============================================================================

# Primary Provider: Groq Cloud (Ultra-fast Llama-3.3-70B inference)
GROQ_API_KEY=

# Secondary Fallback Provider: Google Gemini (Gemini 1.5 Flash)
GEMINI_API_KEY=

# Optional Alternatives (pay-as-you-go / third-party)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Backend Server Configuration
PORT=3001
NODE_ENV=production
