# Environment variables for Nova Learn (Client & Backend)

# ==============================================================================
# 1. BACKEND SERVICE ENVIRONMENT VARIABLES (Set these on Render / Railway)
# ==============================================================================
PORT=3001
HOST=0.0.0.0

# Free-Tier AI Provider Keys (Kept exclusively on backend)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed origins for CORS (comma separated list, or leave empty for auto-detecting Vercel & localhost)
ALLOWED_ORIGINS=https://novalearn.vercel.app

# Optional persistent storage path (e.g., if a persistent volume is mounted at /var/data)
# DATA_DIR=/var/data

# ==============================================================================
# 2. FRONTEND ENVIRONMENT VARIABLES (Set this on Vercel)
# ==============================================================================
# The public URL of your deployed backend (e.g. Render/Railway URL)
# Example: VITE_API_URL=https://nova-learn-backend.onrender.com
VITE_API_URL=
